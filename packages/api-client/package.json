{
  "name": "@platform/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write openapi.json src",
    "format:check": "prettier --check openapi.json src"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prettier": "^3.6.2",
    "typescript": "^5"
  }
}
