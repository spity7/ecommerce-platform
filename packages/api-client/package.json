{
  "name": "@platform/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "generate": "tsx scripts/generate.ts",
    "ensure": "tsx scripts/ensure-contract.ts",
    "check": "tsx scripts/check-contract.ts",
    "format": "prettier --write orval.config.ts openapi-transformer.cjs openapi.json scripts src",
    "format:check": "prettier --check orval.config.ts openapi-transformer.cjs openapi.json scripts src"
  },
  "dependencies": {
    "axios": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
