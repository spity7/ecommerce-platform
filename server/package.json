{
  "name": "@platform/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API server for the ecommerce platform",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run api:ensure --prefix .. && npm run build:packages --prefix ..",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build:packages --prefix ..",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "openapi:generate": "tsx src/openapi/generate.ts",
    "test": "node --import tsx --test test/health.test.ts test/auth.test.ts test/commerce.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@platform/shared": "0.0.1",
    "@platform/site-config": "0.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": "20.x"
  }
}
